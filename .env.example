# Copy this file to ".env" for local dev and fill in your key.
# In production (Render), set these as environment variables in the dashboard.

# OpenAI API key — REQUIRED. Used by the vision model that reads prescriptions.
OPENAI_API_KEY=your-openai-api-key-here

# Vision model used to read the prescription image and emit JSON.
# Use gpt-4o for best accuracy, or gpt-4o-mini for lower cost.
OCR_MODEL=gpt-4o

# Reject uploads larger than this many decoded bytes (default 15 MB).
MAX_IMAGE_BYTES=15728640
